    <edge id="EDG-0003" source="KNO-0001" target="KNO-0002"><data key="relation">contradicts</data></edge>
    <edge id="EDG-0004" source="KNO-0004" target="KNO-0005"><data key="relation">related-to</data></edge>
  </graph>
